#--------------------------------------------------------------------
# قالب متغيرات البيئة — انسخيه لملف .env (غير مرفوع لـ git) واملئي القيم
# الحقيقية هناك فقط. لا تضعي أي قيمة حقيقية بهذا الملف (يُرفع لـ git).
#--------------------------------------------------------------------

CI_ENVIRONMENT = production
app.baseURL = ''

database.default.hostname =
database.default.database =
database.default.username =
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# LDAP (Active Directory) — تسجيل الدخول بالرقم الوظيفي للحسابات اللي
# auth_source = 'ldap' بجدول users
#--------------------------------------------------------------------

# عنوان/IP خادم LDAP
ldap.host =

# المنفذ (389 لـ LDAP العادي، 636 لـ LDAPS)
ldap.port = 389

# حساب الخدمة (Bind DN) المستخدَم للبحث عن الموظفين -- مو حساب مستخدم عادي
ldap.bindDn =

# كلمة مرور حساب الخدمة
ldap.bindPassword =

# قاعدة البحث التنظيمية (Base DN)، مثال: OU=Users,DC=kamc,DC=med,DC=sa
ldap.baseDn =

#--------------------------------------------------------------------
# البريد الإلكتروني (SMTP) — إرسال نسخة بريدية من كل إخطار داخل المنصة
# لإيميل المستخدم المسجَّل من LDAP. لو تُركت فارغة يبقى الإخطار داخل
# المنصة فقط يعمل بدون أي خطأ (تجاهل صامت لخطوة الإرسال البريدي).
#--------------------------------------------------------------------

# عنوان/IP خادم SMTP
email.SMTPHost =

# المنفذ (587 عادةً مع TLS، 465 مع SSL، 25 بدون تشفير)
email.SMTPPort = 587

# اسم مستخدم حساب SMTP
email.SMTPUser =

# كلمة مرور حساب SMTP
email.SMTPPass =

# نوع التشفير: tls أو ssl أو فارغ
email.SMTPCrypto = tls

# البريد الظاهر كمُرسِل
email.fromEmail =

# الاسم الظاهر كمُرسِل
email.fromName = ارتقاء
